generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CONTRACTOR
  SCHOOL
}

enum EntryStatus {
  ACTIVE
  COMPLETED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  DENIED
}

enum PaymentStatus {
  UNPAID
  PAID
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String
  displayName  String
  jobTitle     String       @default("")
  role         Role         @default(CONTRACTOR)
  schoolName   String?
  createdAt    DateTime     @default(now())
  entries      TimeEntry[]
  auditEvents  AuditEvent[]
}

model School {
  id                 String   @id @default(cuid())
  name               String   @unique
  type               String   @default("school")
  parentDistrictId   String?
  discountPercentage Decimal  @default(0) @db.Decimal(5, 2)
  isActive           Boolean  @default(true)
  createdAt          DateTime @default(now())
}

model Category {
  id          String  @id @default(cuid())
  name        String
  key         String  @unique
  hourlyRate  Decimal @db.Decimal(10, 2)
  billingRate Decimal @db.Decimal(10, 2)
  description String  @default("")
  color       String  @default("#4f46e5")
  isActive    Boolean @default(true)
}

model SubCategory {
  id       String  @id @default(cuid())
  name     String
  key      String  @unique
  isActive Boolean @default(true)
}

model MileageRate {
  id          String   @id @default(cuid())
  ratePerMile Decimal  @default(0.76) @db.Decimal(8, 3)
  updatedNote String   @default("")
  createdAt   DateTime @default(now())
}

model TimeEntry {
  id                   String         @id @default(cuid())
  userId               String
  user                 User           @relation(fields: [userId], references: [id])
  contractorName       String
  schoolOrDistrict     String
  category             String
  subCategoryKey       String?
  startTime            DateTime
  endTime              DateTime?
  durationHours        Decimal        @db.Decimal(10, 4)
  billableHours        Decimal        @db.Decimal(10, 2)
  hourlyRate           Decimal        @db.Decimal(10, 2)
  billingRate          Decimal        @db.Decimal(10, 2)
  description          String         @default("")
  mileageMiles         Decimal        @default(0) @db.Decimal(10, 2)
  mileageReimbursement Decimal        @default(0) @db.Decimal(10, 2)
  isManualEntry        Boolean        @default(false)
  status               EntryStatus    @default(COMPLETED)
  approvalStatus       ApprovalStatus @default(PENDING)
  denialReason         String?
  paymentStatus        PaymentStatus  @default(UNPAID)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([userId, startTime])
  @@index([schoolOrDistrict, approvalStatus])
}

model RetainerContractor {
  id                      String    @id @default(cuid())
  contractorName          String
  schoolOrDistrict        String
  monthlyAmount           Decimal   @db.Decimal(12, 2)
  billingAmount           Decimal   @default(0) @db.Decimal(12, 2)
  schoolAllocations       Json?
  allocationMarkupPercent Decimal   @default(0) @db.Decimal(7, 2)
  payFrequency            String    @default("monthly")
  startDate               DateTime  @db.Date
  endDate                 DateTime? @db.Date
  description             String    @default("")
  isActive                Boolean   @default(true)
}

model FixedRevenueContract {
  id               String    @id @default(cuid())
  contractName     String
  schoolOrDistrict String
  monthlyRevenue   Decimal   @db.Decimal(12, 2)
  startDate        DateTime  @db.Date
  endDate          DateTime? @db.Date
  description      String    @default("")
  isActive         Boolean   @default(true)
}

model AuditEvent {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}
